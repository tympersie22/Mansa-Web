generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AdminRole {
  manager
  admin
  super_admin
}

enum CustomerStatus {
  lead
  active
  past_guest
  inactive
}

enum InquiryStatus {
  new
  contacted
  qualified
  proposal_sent
  converted
  closed
}

enum InquiryPriority {
  low
  normal
  high
  urgent
}

enum SupplierType {
  hotel
  transport
  experience
  guide
  restaurant
  flight
  other
}

enum SupplierStatus {
  active
  inactive
  preferred
}

enum RecordStatus {
  active
  inactive
}

enum TripStatus {
  planning
  quoted
  confirmed
  in_progress
  completed
  cancelled
}

enum ItineraryItemType {
  accommodation
  experience
  transfer
  flight
  meal
  guide
  note
  other
}

enum ItineraryItemStatus {
  planned
  requested
  confirmed
  cancelled
  completed
}

enum QuotationStatus {
  draft
  issued
  accepted
  declined
  expired
  superseded
}

enum MediaKind {
  image
  document
}

enum MediaStatus {
  pending
  ready
}

enum ItineraryStatus {
  draft
  published
  archived
}

model User {
  id            String    @id @default(uuid()) @db.Uuid
  name          String?
  email         String?   @unique
  emailVerified DateTime? @map("email_verified") @db.Timestamptz(6)
  image         String?
  passwordHash  String?   @map("password_hash")
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  accounts          Account[]
  sessions          Session[]
  adminProfile      AdminProfile?
  assignedInquiries PlanningInquiry[] @relation("AssignedInquiries")
  createdCustomers  Customer[]        @relation("CustomerCreator")
  createdSuppliers  Supplier[]        @relation("SupplierCreator")
  createdHotels     Hotel[]           @relation("HotelCreator")
  createdTrips      Trip[]            @relation("TripCreator")
  createdQuotations Quotation[]       @relation("QuotationCreator")
  uploadedMedia     MediaAsset[]      @relation("MediaUploader")
  createdItineraries Itinerary[]      @relation("ItineraryCreator")

  @@map("users")
}

model Account {
  id                String  @id @default(uuid()) @db.Uuid
  userId            String  @map("user_id") @db.Uuid
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refreshToken      String? @map("refresh_token") @db.Text
  accessToken       String? @map("access_token") @db.Text
  expiresAt         Int?    @map("expires_at")
  tokenType         String? @map("token_type")
  scope             String?
  idToken           String? @map("id_token") @db.Text
  sessionState      String? @map("session_state")
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id") @db.Uuid
  expires      DateTime @db.Timestamptz(6)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime @db.Timestamptz(6)

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model AdminProfile {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @unique @map("user_id") @db.Uuid
  companyId   String    @default("mansa") @map("company_id")
  role        AdminRole
  displayName String    @map("display_name")
  phone       String?
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyId, role])
  @@map("admin_profiles")
}

model AdminLog {
  id         String   @id @default(uuid()) @db.Uuid
  companyId  String   @default("mansa") @map("company_id")
  propertyId String?  @map("property_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  actor      Json     @default("{}")
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([companyId, createdAt(sort: Desc)])
  @@index([entityType, entityId])
  @@map("admin_logs")
}

model Itinerary {
  id        String          @id @default(uuid()) @db.Uuid
  companyId String          @default("mansa") @map("company_id")
  slug      String
  title     String
  status    ItineraryStatus @default(draft)
  document  Json            @default("{}")
  createdBy String?         @map("created_by") @db.Uuid
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  creator   User?           @relation("ItineraryCreator", fields: [createdBy], references: [id], onDelete: SetNull)

  @@unique([companyId, slug])
  @@index([companyId, status, updatedAt(sort: Desc)])
  @@map("os_itineraries")
}

model MediaAsset {
  id          String      @id @default(uuid()) @db.Uuid
  companyId   String      @default("mansa") @map("company_id")
  objectKey   String      @unique @map("object_key")
  publicUrl   String      @map("public_url")
  fileName    String      @map("file_name")
  contentType String      @map("content_type")
  byteSize    Int         @map("byte_size")
  kind        MediaKind
  status      MediaStatus @default(pending)
  scope       String
  entityType  String?     @map("entity_type")
  entityId    String?     @map("entity_id") @db.Uuid
  uploadedBy  String?     @map("uploaded_by") @db.Uuid
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  uploader    User?       @relation("MediaUploader", fields: [uploadedBy], references: [id], onDelete: SetNull)

  @@index([companyId, scope, createdAt(sort: Desc)])
  @@index([entityType, entityId])
  @@map("media_assets")
}

model Customer {
  id            String            @id @default(uuid()) @db.Uuid
  companyId     String            @default("mansa") @map("company_id")
  fullName      String            @map("full_name")
  email         String?
  phoneWhatsapp String?           @map("phone_whatsapp")
  nationality   String?
  source        String?
  status        CustomerStatus    @default(lead)
  tags          String[]          @default([])
  preferences   Json              @default("{}")
  notes         String?
  lastContactAt DateTime?         @map("last_contact_at") @db.Timestamptz(6)
  createdBy     String?           @map("created_by") @db.Uuid
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  creator       User?             @relation("CustomerCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  inquiries     PlanningInquiry[]
  trips         Trip[]
  quotations    Quotation[]

  @@index([companyId, fullName])
  @@index([companyId, email])
  @@map("customers")
}

model PlanningInquiry {
  id              String          @id @default(uuid()) @db.Uuid
  companyId       String          @default("mansa") @map("company_id")
  legacyJourneyId String?         @map("legacy_journey_id") @db.Uuid
  customerId      String?         @map("customer_id") @db.Uuid
  assignedToId    String?         @map("assigned_to") @db.Uuid
  fullName        String          @map("full_name")
  email           String
  phoneWhatsapp   String?         @map("phone_whatsapp")
  travelStartDate DateTime?       @map("travel_start_date") @db.Date
  travelEndDate   DateTime?       @map("travel_end_date") @db.Date
  isDateFlexible  Boolean         @default(false) @map("is_date_flexible")
  guestCount      Int             @default(1) @map("guest_count")
  message         String?
  sourcePage      String?         @map("source_page")
  status          InquiryStatus   @default(new)
  priority        InquiryPriority @default(normal)
  budgetMin       Decimal?        @map("budget_min") @db.Decimal(14, 2)
  budgetMax       Decimal?        @map("budget_max") @db.Decimal(14, 2)
  currency        String          @default("USD")
  destinations    String[]        @default([])
  travelStyle     String?         @map("travel_style")
  sourceDetail    String?         @map("source_detail")
  internalNotes   String?         @map("internal_notes")
  nextFollowUpAt  DateTime?       @map("next_follow_up_at") @db.Timestamptz(6)
  convertedAt     DateTime?       @map("converted_at") @db.Timestamptz(6)
  utmSource       String?         @map("utm_source")
  utmMedium       String?         @map("utm_medium")
  utmCampaign     String?         @map("utm_campaign")
  utmTerm         String?         @map("utm_term")
  utmContent      String?         @map("utm_content")
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  customer        Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  assignee        User?           @relation("AssignedInquiries", fields: [assignedToId], references: [id], onDelete: SetNull)
  trips           Trip[]

  @@index([companyId, status, createdAt(sort: Desc)])
  @@map("planning_inquiries")
}

model Supplier {
  id             String          @id @default(uuid()) @db.Uuid
  companyId      String          @default("mansa") @map("company_id")
  name           String
  supplierType   SupplierType    @map("supplier_type")
  contactName    String?         @map("contact_name")
  email          String?
  phoneWhatsapp  String?         @map("phone_whatsapp")
  location       String?
  website        String?
  paymentTerms   String?         @map("payment_terms")
  notes          String?
  status         SupplierStatus  @default(active)
  createdBy      String?         @map("created_by") @db.Uuid
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  creator        User?           @relation("SupplierCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  hotels         Hotel[]
  itineraryItems ItineraryItem[]

  @@index([companyId, supplierType, name])
  @@map("suppliers")
}

model Hotel {
  id             String          @id @default(uuid()) @db.Uuid
  companyId      String          @default("mansa") @map("company_id")
  supplierId     String?         @map("supplier_id") @db.Uuid
  name           String
  location       String
  address        String?
  starRating     Decimal?        @map("star_rating") @db.Decimal(2, 1)
  contactName    String?         @map("contact_name")
  email          String?
  phoneWhatsapp  String?         @map("phone_whatsapp")
  website        String?
  checkInTime    DateTime?       @map("check_in_time") @db.Time(6)
  checkOutTime   DateTime?       @map("check_out_time") @db.Time(6)
  amenities      String[]        @default([])
  notes          String?
  status         SupplierStatus  @default(active)
  createdBy      String?         @map("created_by") @db.Uuid
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  supplier       Supplier?       @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  creator        User?           @relation("HotelCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  roomTypes      RoomType[]
  itineraryItems ItineraryItem[]

  @@index([companyId, location, name])
  @@map("hotels")
}

model RoomType {
  id               String          @id @default(uuid()) @db.Uuid
  companyId        String          @default("mansa") @map("company_id")
  hotelId          String          @map("hotel_id") @db.Uuid
  name             String
  description      String?
  maxAdults        Int             @default(2) @map("max_adults")
  maxChildren      Int             @default(0) @map("max_children")
  bedConfiguration String?         @map("bed_configuration")
  mealPlan         String?         @map("meal_plan")
  currency         String          @default("USD")
  defaultCost      Decimal?        @map("default_cost") @db.Decimal(14, 2)
  defaultSellPrice Decimal?        @map("default_sell_price") @db.Decimal(14, 2)
  status           RecordStatus    @default(active)
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  hotel            Hotel           @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  itineraryItems   ItineraryItem[]

  @@index([hotelId, name])
  @@map("room_types")
}

model Trip {
  id               String           @id @default(uuid()) @db.Uuid
  companyId        String           @default("mansa") @map("company_id")
  inquiryId        String?          @map("inquiry_id") @db.Uuid
  customerId       String           @map("customer_id") @db.Uuid
  title            String
  status           TripStatus       @default(planning)
  startDate        DateTime?        @map("start_date") @db.Date
  endDate          DateTime?        @map("end_date") @db.Date
  guestCount       Int              @default(1) @map("guest_count")
  currency         String           @default("USD")
  inquirySnapshot  Json             @default("{}") @map("inquiry_snapshot")
  customerSnapshot Json             @default("{}") @map("customer_snapshot")
  internalNotes    String?          @map("internal_notes")
  createdBy        String?          @map("created_by") @db.Uuid
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  inquiry          PlanningInquiry? @relation(fields: [inquiryId], references: [id], onDelete: SetNull)
  customer         Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  creator          User?            @relation("TripCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  days             TripDay[]
  quotations       Quotation[]

  @@index([companyId, status, startDate])
  @@index([inquiryId])
  @@map("trips")
}

model TripDay {
  id             String          @id @default(uuid()) @db.Uuid
  companyId      String          @default("mansa") @map("company_id")
  tripId         String          @map("trip_id") @db.Uuid
  dayNumber      Int             @map("day_number")
  tripDate       DateTime?       @map("trip_date") @db.Date
  title          String
  location       String?
  summary        String?
  notes          String?
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  trip           Trip            @relation(fields: [tripId], references: [id], onDelete: Cascade)
  itineraryItems ItineraryItem[]
  quotationItems QuotationItem[]

  @@unique([tripId, dayNumber])
  @@index([tripId, dayNumber])
  @@map("trip_days")
}

model ItineraryItem {
  id                    String              @id @default(uuid()) @db.Uuid
  companyId             String              @default("mansa") @map("company_id")
  tripDayId             String              @map("trip_day_id") @db.Uuid
  supplierId            String?             @map("supplier_id") @db.Uuid
  hotelId               String?             @map("hotel_id") @db.Uuid
  roomTypeId            String?             @map("room_type_id") @db.Uuid
  itemType              ItineraryItemType   @map("item_type")
  startTime             DateTime?           @map("start_time") @db.Time(6)
  endTime               DateTime?           @map("end_time") @db.Time(6)
  title                 String
  description           String?
  location              String?
  confirmationReference String?             @map("confirmation_reference")
  status                ItineraryItemStatus @default(planned)
  sortOrder             Int                 @default(0) @map("sort_order")
  quantity              Decimal             @default(1) @db.Decimal(12, 2)
  costAmount            Decimal?            @map("cost_amount") @db.Decimal(14, 2)
  sellAmount            Decimal?            @map("sell_amount") @db.Decimal(14, 2)
  currency              String              @default("USD")
  supplierSnapshot      Json                @default("{}") @map("supplier_snapshot")
  serviceSnapshot       Json                @default("{}") @map("service_snapshot")
  notes                 String?
  createdAt             DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  tripDay               TripDay             @relation(fields: [tripDayId], references: [id], onDelete: Cascade)
  supplier              Supplier?           @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  hotel                 Hotel?              @relation(fields: [hotelId], references: [id], onDelete: SetNull)
  roomType              RoomType?           @relation(fields: [roomTypeId], references: [id], onDelete: SetNull)
  quotationItems        QuotationItem[]

  @@index([tripDayId, sortOrder])
  @@map("itinerary_items")
}

model Quotation {
  id               String          @id @default(uuid()) @db.Uuid
  companyId        String          @default("mansa") @map("company_id")
  tripId           String          @map("trip_id") @db.Uuid
  customerId       String          @map("customer_id") @db.Uuid
  quotationNumber  String          @default(dbgenerated("'Q-' || to_char(now(), 'YYYYMMDD') || '-' || upper(substr(replace(gen_random_uuid()::text, '-', ''), 1, 6))")) @map("quotation_number")
  revision         Int             @default(1)
  status           QuotationStatus @default(draft)
  currency         String          @default("USD")
  subtotal         Decimal         @default(0) @db.Decimal(14, 2)
  taxAmount        Decimal         @default(0) @map("tax_amount") @db.Decimal(14, 2)
  totalAmount      Decimal         @default(0) @map("total_amount") @db.Decimal(14, 2)
  validUntil       DateTime?       @map("valid_until") @db.Date
  terms            String?
  customerSnapshot Json            @map("customer_snapshot")
  tripSnapshot     Json            @map("trip_snapshot")
  issuedAt         DateTime?       @map("issued_at") @db.Timestamptz(6)
  acceptedAt       DateTime?       @map("accepted_at") @db.Timestamptz(6)
  createdBy        String?         @map("created_by") @db.Uuid
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  trip             Trip            @relation(fields: [tripId], references: [id], onDelete: Restrict)
  customer         Customer        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  creator          User?           @relation("QuotationCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  items            QuotationItem[]

  @@unique([companyId, quotationNumber])
  @@unique([tripId, revision])
  @@index([tripId, revision(sort: Desc)])
  @@map("quotations")
}

model QuotationItem {
  id               String         @id @default(uuid()) @db.Uuid
  companyId        String         @default("mansa") @map("company_id")
  quotationId      String         @map("quotation_id") @db.Uuid
  tripDayId        String?        @map("trip_day_id") @db.Uuid
  itineraryItemId  String?        @map("itinerary_item_id") @db.Uuid
  category         String
  description      String
  quantity         Decimal        @default(1) @db.Decimal(12, 2)
  unitPrice        Decimal        @default(0) @map("unit_price") @db.Decimal(14, 2)
  totalAmount      Decimal        @default(0) @map("total_amount") @db.Decimal(14, 2)
  sortOrder        Int            @default(0) @map("sort_order")
  supplierSnapshot Json           @default("{}") @map("supplier_snapshot")
  itemSnapshot     Json           @default("{}") @map("item_snapshot")
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  quotation        Quotation      @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  tripDay          TripDay?       @relation(fields: [tripDayId], references: [id], onDelete: SetNull)
  itineraryItem    ItineraryItem? @relation(fields: [itineraryItemId], references: [id], onDelete: SetNull)

  @@index([quotationId, sortOrder])
  @@map("quotation_items")
}
