DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"
AUTH_SECRET="generate-with-npx-auth-secret"
AUTH_TRUST_HOST="true"

# Trusted provisioning only. There is intentionally no public registration route.
ADMIN_EMAIL="admin@mansa.travel"
ADMIN_PASSWORD="replace-with-at-least-12-characters"
ADMIN_NAME="Mansa OS Administrator"

# Cloudflare R2. Use an Object Read & Write token scoped to this bucket only.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="mansa-assets-dev"
# Use the bucket's r2.dev URL locally and an R2 custom domain in production.
R2_PUBLIC_BASE_URL=""
R2_ALLOWED_ORIGINS="http://localhost:3001,https://mansa-admin-ten.vercel.app"
